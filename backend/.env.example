# Copy these values into the repository-root .env file. Do not commit that file.
GATE_SECRET=replace-with-a-long-random-secret
# Optional. If omitted, backend/dartmouth.db is used.
DATABASE_URL=sqlite:///./dartmouth.db
# Deployment configuration. The fake-data version does not call Anthropic yet.
ANTHROPIC_API_KEY=replace-with-your-api-key
MODEL=replace-with-the-model-name-you-plan-to-use
